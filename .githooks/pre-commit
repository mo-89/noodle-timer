#!/bin/sh
# sw.js の CACHE_NAME をコミットのたびに自動更新する。
#
# キャッシュ対象ファイル(sw.js の ASSETS と同じ一覧)の内容から
# ハッシュを計算し、「日付-ハッシュ」形式のバージョン文字列を
# CACHE_NAME に書き込む。値が変わった場合のみ sw.js を書き換えて
# ステージし直す。これにより、キャッシュ対象のファイルを変更して
# コミットするたびに、Service Worker のキャッシュが自動的に
# 新しいキャッシュストレージへ切り替わる(古いキャッシュは sw.js の
# activate イベントで削除される)。
#
# 注意: このフックは `git config core.hooksPath .githooks` を実行した
# リポジトリでのみ有効(ローカルgit設定のため)。新しくクローンした
# 環境やCI/Cloudflare Pagesのビルド環境では自動的には有効にならない。
# 有効化を忘れてキャッシュ対象ファイルをコミットすると CACHE_NAME が
# 更新されず、デプロイしてもクライアント側のキャッシュが古いままに
# なる可能性がある。詳細は README.md の
# 「Service Workerのキャッシュ更新について」を参照。
set -e

cd "$(git rev-parse --show-toplevel)"

SW_FILE="sw.js"
[ -f "$SW_FILE" ] || exit 0

ASSET_FILES="index.html style.css script.js manifest.json favicon.ico apple-touch-icon.png apple-touch-icon-precomposed.png icons/icon-192.png icons/icon-512.png icons/apple-touch-icon.png"

HASH=$(cat $ASSET_FILES 2>/dev/null | shasum -a 256 | cut -c1-10)
DATE=$(date +%Y%m%d)
VERSION="noodle-timer-v${DATE}-${HASH}"

CURRENT=$(sed -n 's/^const CACHE_NAME = "\(.*\)";/\1/p' "$SW_FILE")

if [ "$CURRENT" != "$VERSION" ]; then
  awk -v v="$VERSION" '
    /^const CACHE_NAME = / { print "const CACHE_NAME = \"" v "\";"; next }
    { print }
  ' "$SW_FILE" > "$SW_FILE.tmp"
  mv "$SW_FILE.tmp" "$SW_FILE"
  git add "$SW_FILE"
  echo "sw.js: CACHE_NAME を ${VERSION} に更新しました"
fi
